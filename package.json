{
  "name": "komari-theme-observer",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Observer — a futuristic, minimalist theme for Komari Monitor",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "lint": "tsc -b",
    "verify": "node scripts/verify-dist.mjs",
    "package": "bash scripts/build-theme.sh",
    "catalog": "node scripts/make-catalog.mjs",
    "catalog:check": "node scripts/make-catalog.mjs --check",
    "mock": "node scripts/mock-server.mjs",
    "preview:mock": "vite preview",
    "preview-image": "node scripts/make-preview.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "i18next": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "react-router": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
